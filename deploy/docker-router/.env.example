# ============================================================
# CS2Suite MySQL — 环境变量(复制为 .env 后修改)
# ============================================================

# ---- 必改:密码(建议 16 位以上,含大小写与符号)----
MYSQL_ROOT_PASSWORD=ChangeMe_Root_Password_123!
MYSQL_PASSWORD=ChangeMe_Cs2Suite_User_123!

# ---- 库名与用户名(与插件/网页 config 中的 Database/User 保持一致)----
MYSQL_DATABASE=cs2suite
MYSQL_USER=cs2suite

# ---- 对外端口(路由器上监听的端口;冲突时改成 3307 等)----
MYSQL_PORT=3306

# ---- 时区(务必与你的实际时区一致,影响比赛/排行榜时间)----
TZ=Asia/Shanghai
MYSQL_TZ=+08:00

# ---- 资源与性能(按路由器内存调整)----
# 512MB 内存的路由器建议 64M;1GB 可给 128M;2GB 可给 256M
MYSQL_BUFFER_POOL=64M
# 容器内存硬上限
MYSQL_MEM_LIMIT=512m
# 最大连接数(游戏服 + 网页 + 几个管理连接足够)
MYSQL_MAX_CONN=50
